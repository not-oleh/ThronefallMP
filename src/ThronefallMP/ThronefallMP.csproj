<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.4.0</Version>
    <GameDir>$(MSBuildThisFileDirectory)../../game</GameDir>
    <Managed>$(GameDir)/thronefall.app/Contents/Resources/Data/Managed</Managed>
    <PluginDir>$(GameDir)/BepInEx/plugins/ThronefallMP</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: compile against the game's own DLLs, never ship them. -->
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)/Rewired_Core.dll" Private="false" />
    <Reference Include="$(Managed)/com.rlabrecque.steamworks.net.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.ScreenCaptureModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)" />
  </Target>
</Project>
